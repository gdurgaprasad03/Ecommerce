# =========================================================================
# Copy this file to .env and fill in REAL values. NEVER commit .env.
# Generate a fresh secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# =========================================================================

# --- Django core ---
DJANGO_SECRET_KEY=REPLACE_WITH_STRONG_SECRET_KEY_50_CHARS_MIN
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_TIME_ZONE=Asia/Kolkata
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- Database (Neon Postgres) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=True
DB_SSL_REQUIRE=True

# --- Redis (cache + Celery broker + result backend) ---
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MAX_CONNECTIONS=50
CACHE_TIMEOUT=3600
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
# Set to True ONLY when running unit tests. NEVER in production.
CELERY_EAGER=False

# --- Email (Gmail SMTP example) ---
EMAIL_BACKEND=djcelery_email.backends.CeleryEmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=
SALES_NOTIFICATION_EMAIL=
EMAIL_RETRY_INTERVAL=60
EMAIL_MAX_RETRIES=3

# --- JWT / OTP ---
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Frontend integration ---
FRONTEND_BASE_URL=https://yourdomain.com

# --- ImageKit (media storage) ---
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Elasticsearch (optional) ---
USE_ELASTICSEARCH=False
ELASTICSEARCH_HOSTS=http://localhost:9200
ELASTICSEARCH_VERIFY_CERTS=True
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# --- Analytics ---
ANALYTICS_CACHE_TIMEOUT=3600
ENABLE_ANALYTICS=True

# --- Gunicorn (consumed by gunicorn.conf.py) ---
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=30
GUNICORN_LOGLEVEL=info
